    # 4. IP 分配
    interfaces = {
      # WAN 口：挂在上级路由下面，自动通过 DHCP 获取一个上级网段的 IP
      "enp1s0".useDHCP = true;

      # LAN 网桥：给你的内网设备开辟一个独立的纯净网段
      "br0" = {
        ipv4.addresses = [{
          address = "192.168.10.1"; # ──> 故意换成 .10 网段，避免与光猫默认的 192.168.1.1 冲突
          prefixLength = 24;
