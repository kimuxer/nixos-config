      dhcp-range = "192.168.10.10,192.168.10.250,12h";
      dhcp-option = [
        "3,192.168.10.1" # 把所有设备的默认网关指向工控机，由 dae 进行分流
        "6,192.168.10.1" # 把所有设备的 DNS 指向工控机，防止 DNS 污染
      ];
    };
  };
