{ inputs, pkgs, ... }:
{
  imports = [ inputs.nvf.homeManagerModules.default ];

  programs.nvf = {
    enable = true;

    settings.vim = {
      # 基础配置
      viAlias = true;
      vimAlias = true;
      lsp.enable = true;

      # Neovim 选项
      options = {
        mouse = "a";
        number = true;
        relativenumber = true;
        autoindent = true;
        termguicolors = true;
      };

      # 状态栏 lualine 自动匹配主题
      statusline.lualine = {
        enable = true;
        theme = "base46-matugen";
      };

      # ==============================
      # DMS 专用 base46（完全正确）
      # ==============================
      extraPlugins = {
        base46 = {
          package = pkgs.vimUtils.buildVimPlugin {
            name = "base46-dms";
            src = pkgs.fetchFromGitHub {
              owner = "AvengeMedia";
              repo = "base46";
              rev = "eb54ce664c6452f7d485ab2a5a5f960b3ca975b5";
              hash = "sha256-CChdU3m1w7KgK+m5yBmrF2kE1s+kAfHzk+MhVKu/ggE=";
            };
          };

          # ==============================
          # ✅ 正确主题名：base46-matugen
          # ✅ 支持热重载
          # ✅ DMS 壁纸变色 → nvim 实时变
          # ==============================
          setup = ''
            require("base46").setup({})
            vim.cmd.colorscheme("base46-matugen")
          '';
        };
      };
    };
  };

  home.sessionVariables = {
    EDITOR = "nvim";
    VISUAL = "nvim";
  };
}
