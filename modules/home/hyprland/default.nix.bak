{ config, pkgs, inputs, lib, ... }:

let
  # 定义 Lua 配置所在的目录
  configDir = ./config;
  # 获取该目录下所有的文件列表
  luaFiles = builtins.attrNames (builtins.readDir configDir);
in
{
  imports = [
    inputs.dms.homeModules.dank-material-shell
    # 注意：如果这些子模块里依然包含 settings = { ... }，
    # 建议你将它们的内容逐步迁移到 config/ 目录下的 .lua 文件中，并从这里移除 imports
  ];

  # 自动化投递：将 config 目录下的所有 Lua 文件投递到 ~/.config/hypr/
  home.file = lib.listToAttrs (map (file: {
    name = ".config/hypr/${file}";
    value = { source = "${configDir}/${file}"; };
  }) luaFiles);

  wayland.windowManager.hyprland = {
    enable = true;
    # 关闭 systemd.enable 以符合你当前的 UWSM 隔离需求
    systemd.enable = false;

    # 核心：完全不使用 settings 结构，强制 Hyprland 只读取 main.lua
    # 这样 Home Manager 不会再进行任何 Lua 语法的自动转译
    # 直接注入执行指令，抛弃 source，抛弃 main.lua
    extraConfig = ''
      -- dofile("${config.home.homeDirectory}/.config/hypr/animations.lua")
      -- dofile("${config.home.homeDirectory}/.config/hypr/input.lua")
      -- dofile("${config.home.homeDirectory}/.config/hypr/layout.lua")
      -- dofile("${config.home.homeDirectory}/.config/hypr/binds.lua")
      dofile("${config.home.homeDirectory}/.config/hypr/window-rules.lua")
      dofile("${config.home.homeDirectory}/.config/hypr/autostart.lua")
      -- dofile("${config.home.homeDirectory}/.config/hypr/env.lua")
    '';
  };

  programs.dank-material-shell = {
    enable = true;
    # 同样关闭 DMS 的 systemd，改由 Hyprland 的 exec-once 调用
    systemd.enable = false;
    enableSystemMonitoring = true;
    dgop.package = inputs.dgop.packages.${pkgs.stdenv.hostPlatform.system}.default;
  };

  services.udiskie.enable = true;
}
