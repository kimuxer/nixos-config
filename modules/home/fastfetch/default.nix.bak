{ pkgs, ... }:

let
  # 使用内置 logo 或者直接写死在 settings 里其实更简单，
  # 但如果你一定要用 logoFile，目前的写法是可以的。
  logoFile = pkgs.writeText "fastfetch-logo.txt" ''
   _  ___      ____  ____
  / |/ (_)_ __/ __ \/ __/
 /    / /\ \ / /_/ /\ \
/_/|_/_//_\_\\____/___/
'';
in
{
  programs.fastfetch = {
    enable = true;

    settings = {
      logo = {
        source = "${logoFile}";
        position = "top";
        padding.left = 3;
      };

      display = {
        key.width = 8;
        separator = "";
      };

      modules = [
        { type = "custom";   key = "╭── system ──────┄"; }
        { type = "os";       key = "│  os      "; }
        { type = "kernel";   key = "│  kernel  "; }
        { type = "wm";       key = "│  wm      "; }
        { type = "shell";    key = "│  shell   "; }
        { type = "terminal"; key = "│  term    "; }
        { type = "memory";   key = "│  mem     "; }
        { type = "colors";   key = "╰─┄"; symbol = "circle"; }
      ];
    };
  };
}
