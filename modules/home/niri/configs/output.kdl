// =========================================================================
// niri : output.kdl
// =========================================================================
output "HDMI-A-1" {
    // 🛠️ 1. 显式开启显示器
    enable

    // 🛠️ 2. 扁平化拆解：对应原配置的 mode 嵌套块
    mode width=1920 height=1080 refresh=60.0

    // 🛠️ 3. 完美像素级 1:1 缩放，确保 24寸屏幕下字体锐利不发虚
    scale 1.0
}
